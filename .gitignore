# Operator-generated company configs (specific to operator's experiments, not project examples)
# Match bare files too (e.g. `preview --output` writes a single file), not just subdirs.
examples/generated-companies/*
!examples/generated-companies/.gitkeep
!examples/generated-companies/example-*/

# Logs
*.log
logs/

# Anthropic API responses cached for testing (may contain operator-specific data)
.cache/

# spec-kit feature specs (these are working files, may want to commit selectively later)
# Keep these for now; review at v0.1 completion
# .specify/specs/

# Generated config snapshots
*.snapshot

